local __spamRunning = false
local __spamCoroutine = nil
local function __startSpam(msg)
    if __spamRunning then return "Already spamming" end
    if not msg or msg == "" then return "Empty message" end
    __spamRunning = true
    __spamCoroutine = task.spawn(function()
        while __spamRunning do
            __send(msg)
            task.wait(0.1)
        end
    end)
    return "Spam started"
end
local function __stopSpam()
    if not __spamRunning then return "Not spamming" end
    __spamRunning = false
    if __spamCoroutine then task.cancel(__spamCoroutine) end
    return "Spam stopped"
end

