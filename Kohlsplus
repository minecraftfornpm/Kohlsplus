__inputBox.FocusLost:Connect(function(enter)
    if enter and __isOpen then
        local txt = __inputBox.Text
        if txt ~= "" then
            local args = {}
            for word in txt:gmatch("%S+") do table.insert(args, word) end
            local cmd = args[1] or ""
            local target = args[2] or ""
            if cmd:sub(1,1) == PREFIX then cmd = cmd:sub(2) end
            local result = __processCommand(cmd, target, args)
            if result then WindUI:Notify({ Title = "Cmd", Content = result, Duration = 3 }) end
        end
        __inputBox.Text = ""
        __inputBox.Size = UDim2.new(0, 0, 0, 61)
        __inputBox.Visible = false
        __isOpen = false
    end
end)

