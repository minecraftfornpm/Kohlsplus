local __trapRunning = {}
local function __trapPlayer(input, time)
    if not __hasAdmin() then return "No admin" end
    local args = {}
    for word in (input):gmatch("%S+") do table.insert(args, word) end
    local playerName = args[1]
    local timeStr = args[2]
    if not playerName then return "Usage: "..PREFIX.."trap <player> [time]" end
    local plr = __getPlayer(playerName)
    if not plr then return "Player not found" end
    if plr == __player then return "Cannot trap yourself" end
    if __isProtected(plr) then return "Player is protected" end
    if __trapRunning[plr.Name] then
        task.cancel(__trapRunning[plr.Name])
        __trapRunning[plr.Name] = nil
        __send("ungear me")
        return "Trap stopped on "..plr.Name
    end
    local duration = tonumber(timeStr) or -1
    __trapRunning[plr.Name] = task.spawn(function()
        local startTime = tick()
        while __trapRunning[plr.Name] and plr and plr.Parent do
            if duration > 0 and tick() - startTime > duration then
                break
            end
            __send("give me 82357101")
            task.wait(0.3)
            __send("tp me "..plr.Name)
            task.wait(0.3)
            local char = __player.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function() tool:Activate() end)
                end
            end
            task.wait(1)
        end
        __send("ungear me")
        __trapRunning[plr.Name] = nil
    end)
    return "Trap started on "..plr.Name..(duration > 0 and " for "..duration.." seconds" or " (infinite)")
end

local function __clearParts()
    if not __hasAdmin() then return "No admin" end
    local count = 0
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            local parent = obj.Parent
            local keep = false
            while parent do
                if parent.Name == "Terrain" or parent.Name == "Tabby" or parent.Name == "_Game" then
                    keep = true
                    break
                end
                parent = parent.Parent
            end
            if not keep then
                obj:Destroy()
                count = count + 1
            end
        end
    end
    return "Cleared "..count.." player-made parts"
end

